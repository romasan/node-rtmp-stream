{
  "name": "@pixelbattle/admin",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "dev": "node ../../scripts/dev-admin.js",
    "build": "parcel build pages/qq/index.html pages/404.html pages/login/index.html pages/logout/index.html --dist-dir dist --no-source-maps --no-cache --no-autoinstall",
    "check": "tsc --noEmit -p tsconfig.json",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "classnames": "^2.3.2",
    "event-emitter": "^0.3.5",
    "is-mobile": "^4.0.0",
    "protobufjs": "8.8.1",
    "react-chartkick": "^0.5.4",
    "chart.js": "^4.4.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "process": "0.11.10"
  }
}
