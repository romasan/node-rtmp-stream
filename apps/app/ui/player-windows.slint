import { ScrollView } from "std-widgets.slint";
import { PaletteFrame } from "palette-frame.slint";

export struct MessageRow {
    time: string,
    name: string,
    label: string,
    area: string,
    text: styled-text,
}

export struct ChatDay {
    label: string,
    messages: [MessageRow],
}

export struct PlayerRow {
    name: string,
    area: string,
    count: string,
    place: string,
}

export component PlatformIcon inherits Image {
    in property <string> area;
    width: 16px;
    height: 16px;
    image-fit: contain;
    source: area == "twitch" ? @image-url("../../../assets/twitch_bw.svg")
        : area == "discord" ? @image-url("../../../assets/discord_bw.svg")
        : area == "steam" ? @image-url("../../../assets/steam_bw.svg")
        : area == "telegram" ? @image-url("../../../assets/telegram_bw.svg")
        : area == "vk" ? @image-url("../../../assets/vk_bw.svg")
        : area == "system" ? @image-url("../../../assets/star.svg")
        : @image-url("");
}

component PanelButton inherits PaletteFrame {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    fill: hit.pressed ? #8080a6 : hit.has-hover ? #b5b4ea : #9e9ecc;
    raised: !hit.pressed;
    opacity: enabled ? 1 : 0.5;
    Text { text: root.label; color: black; horizontal-alignment: center; vertical-alignment: center; }
    hit := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.label == "×" ? "Закрыть" : "Отправить сообщение";
        accessible-action-default => { root.clicked(); }
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PlayerWindow inherits PaletteFrame {
    in property <length> content-top: 31px;
    in property <length> close-top: 5px;
    in property <length> close-right: 8px;
    callback close();
    callback drag(length, length);
    fill: #aaa8d9;
    raised: true;
    thickness: 3px;
    TouchArea {}
    body := Rectangle {
        x: 7px;
        y: root.content-top;
        width: parent.width - 14px;
        height: parent.height - root.content-top - 7px;
        @children
    }
    Rectangle {
        x: 7px;
        y: 7px;
        width: parent.width - 37px;
        height: 16px;
        for stripe in 4: Rectangle {
            y: stripe * 4px + 2px;
            height: 1px;
            background: #2d2d3a;
            Rectangle { y: 1px; height: 1px; background: #edeefc; }
        }
        TouchArea {
            property <length> start-x;
            property <length> start-y;
            mouse-cursor: grab;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.start-x = self.mouse-x;
                    self.start-y = self.mouse-y;
                }
            }
            moved => {
                if self.pressed { root.drag(self.mouse-x - self.start-x, self.mouse-y - self.start-y); }
            }
        }
    }
    Rectangle {
        x: parent.width - root.close-right - 18px - 4px;
        y: root.close-top - 4px;
        width: 26px; height: 27px;
        background: #aaa8d9;
        PanelButton {
            x: 4px; y: 4px; width: 18px; height: 19px;
            label: "×";
            clicked => { root.close(); }
        }
    }
}

export component ChatContent inherits Rectangle {
    in property <bool> mobile;
    in-out property <length> scroll-position <=> scroll.viewport-y;
    in property <[ChatDay]> days;
    in property <string> nickname;
    in property <bool> authorized;
    in property <bool> sending;
    in-out property <string> draft;
    callback send(string);
    callback open-link(string);
    property <string> chat-font: "Custom Font ttf 12h 1.0";

    function submit() {
        if root.authorized && !root.sending && root.draft != "" { root.send(root.draft); }
    }

    changed days => { scroll.viewport-y = Math.min(0px, scroll.height - scroll.viewport-height); }

    PaletteFrame {
        y: 0;
        width: parent.width;
        height: parent.height - 33px;
        fill: #dbdbef;
        radius: 5px;
        scroll := ScrollView {
            mouse-drag-pan-enabled: root.mobile;
            x: 5px; y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            viewport-height: rows.preferred-height;
            rows := VerticalLayout {
                width: scroll.visible-width;
                spacing: 0px;
                if root.days.length == 0: Text {
                    color: black;
                    text: "пока никто не писал";
                    font-family: root.chat-font;
                    font-size: 16px;
                }
                for day in root.days: Rectangle {
                    height: entries.preferred-height;
                    entries := VerticalLayout {
                        spacing: 0px;
                        if day.label != "": Rectangle { height: heading.preferred-height; }
                        for message in day.messages: VerticalLayout {
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 4px;
                                PlatformIcon { area: message.area; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-height: 17px;
                                    Text {
                                        x: 0;
                                        width: parent.width;
                                        text: message.label;
                                        color: black;
                                        overflow: elide;
                                        horizontal-alignment: left;
                                        font-family: root.chat-font;
                                        font-size: 16px;
                                        letter-spacing: 1px;
                                    }
                                    if root.authorized && message.name != root.nickname && message.name != "": TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.draft = root.draft + (root.draft == "" ? "" : " ") + "@" + message.name + " ";
                                            editor.focus();
                                            editor.select-all();
                                            editor.clear-selection();
                                        }
                                    }
                                }
                                Text {
                                    text: message.time;
                                    color: black;
                                    font-family: root.chat-font;
                                    font-size: 16px;
                                    letter-spacing: 1px;
                                }
                            }
                            StyledText {
                                text: message.text;
                                default-color: black;
                                default-font-family: root.chat-font;
                                default-font-size: 16px;
                                link-clicked(url) => { root.open-link(url); }
                            }
                        }
                    }
                    Rectangle {
                        visible: day.label != "";
                        y: Math.max(0px, Math.min(parent.height - self.height, -scroll.viewport-y - parent.y));
                        height: heading.preferred-height;
                        background: #dbdbef;
                        heading := Text {
                            text: day.label;
                            color: black;
                            horizontal-alignment: center;
                            font-family: root.chat-font;
                            font-size: 16px;
                        }
                    }
                }
            }
        }
    }
    PaletteFrame {
        y: parent.height - 30px; height: 30px;
        fill: #bbbaf1;
        radius: 5px;
        Text {
            x: 6px; width: parent.width - 40px;
            text: root.authorized ? "НАПИСАТЬ СООБЩЕНИЕ" : "АВТОРИЗУЙТЕСЬ, ЧТОБЫ НАПИСАТЬ";
            color: #757575;
            vertical-alignment: center;
            overflow: elide;
            visible: root.draft == "" && !editor.has-focus;
            font-family: root.chat-font;
            font-size: 16px;
            font-weight: 700;
        }
        Rectangle {
            x: 6px; y: 5px;
            width: parent.width - 40px; height: parent.height - 10px;
            clip: true;
            editor := TextInput {
                property <length> scroll-x;
                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                text <=> root.draft;
                enabled: root.authorized;
                color: black;
                font-family: root.chat-font;
                font-size: 16px;
                font-weight: 700;
                single-line: true;
                cursor-position-changed(position) => {
                    if position.x + self.scroll-x < 0px {
                        self.scroll-x = -position.x;
                    } else if position.x + self.scroll-x > parent.width - self.text-cursor-width {
                        self.scroll-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                accepted => { root.submit(); }
            }
        }
        PanelButton {
            x: parent.width - 28px; y: 2px;
            width: 26px; height: 26px;
            label: "↵";
            enabled: root.authorized && !root.sending;
            clicked => { root.submit(); }
        }
    }
}

component StatisticsText inherits Text {
    color: black;
    font-family: "Custom Font ttf 12h 1.0";
    font-size: 16px;
    vertical-alignment: center;
}

component PlayerLine inherits HorizontalLayout {
    in property <PlayerRow> entry;
    height: 21.5px;
    spacing: 4px;
    StatisticsText {
        text: entry.place == "" ? "" : entry.place + ".";
        width: 20px;
        horizontal-alignment: right;
    }
    PlatformIcon { area: entry.area; }
    StatisticsText {
        text: entry.name; overflow: elide; horizontal-stretch: 1;
    }
    StatisticsText { text: entry.count; }
}

export component StatisticsContent inherits PaletteFrame {
    in property <bool> mobile;
    out property <length> content-height: rows.preferred-height + 24px;
    in-out property <length> scroll-position <=> scroll.viewport-y;
    in property <string> status;
    in property <string> total;
    in property <int> online;
    in property <[PlayerRow]> leaders;
    in property <[PlayerRow]> players;

    fill: #dbdbef;
    radius: 5px;
    scroll := ScrollView {
        mouse-drag-pan-enabled: root.mobile;
        x: 12px; y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        viewport-height: rows.preferred-height;
        changed viewport-height => {
            self.viewport-y = Math.max(Math.min(0px, self.height - self.viewport-height), self.viewport-y);
        }
        changed height => {
            self.viewport-y = Math.max(Math.min(0px, self.height - self.viewport-height), self.viewport-y);
        }
        rows := VerticalLayout {
            width: scroll.visible-width;
            if root.status != "": StatisticsText { height: 16px; text: root.status; }
            if root.status == "": VerticalLayout {
                StatisticsText {
                    text: "Всего поставлено пикселей: " + root.total;
                    wrap: word-wrap;
                    height: Math.max(16px, self.preferred-height);
                }
                Rectangle { height: 10px; }
                StatisticsText { height: 16px; text: "ТОП участников:"; }
                Rectangle { height: 5px; }
                for entry in root.leaders: PlayerLine { entry: entry; }
                if root.online > 0: VerticalLayout {
                    Rectangle { height: 10px; }
                    StatisticsText { height: 16px; text: "Онлайн (" + root.online + "):"; }
                    Rectangle { height: 5px; }
                    for entry in root.players: PlayerLine { entry: entry; }
                    if root.players.length > root.online: StatisticsText {
                        x: 24px;
                        height: 16px;
                        text: "и ещё " + (root.players.length - root.online) + " игрока";
                    }
                }
            }
        }
    }
}
