{
  "name": "@pixelbattle/server",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "dev": "cd ../.. && nodemon --exitcrash --watch 'apps/server/**/*.ts' --exec 'ts-node --project apps/server/tsconfig.json' apps/server/index.ts",
