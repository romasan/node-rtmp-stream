{
  "name": "rtmp-stream",
  "version": "2.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently --kill-others -n admin,app,server -c blue,magenta,green \"npm:dev:admin\" \"npm:dev:app\" \"npm:dev:server\"",
    "dev:admin": "npm run dev --workspace @pixelbattle/admin",
    "dev:app": "cd apps/app && trunk serve",
    "dev:server": "npm run dev --workspace @pixelbattle/server",
    "build": "npm run build:admin && npm run build:app && npm run build:server && node scripts/assemble-site.js",
    "build:admin": "npm run build --workspace @pixelbattle/admin",
    "build:app": "cd apps/app && trunk build --release",
    "build:server": "npm run build --workspace @pixelbattle/server",
    "check": "npm run check --workspace @pixelbattle/admin && npm run check --workspace @pixelbattle/server && cargo check --locked --workspace && cargo check --locked --workspace --target wasm32-unknown-unknown",
    "test": "npm run test:server && npm run test:app && node --test scripts/tests/*.test.cjs",
    "start": "npm run build:server && pm2 start node ./lib/index.js --name pixelbattle",
    "stop": "pm2 stop pixelbattle && pm2 delete pixelbattle",
    "tools": "node ./tools/index.js",
    "benchmark:ws": "npm run build:server && node scripts/benchmark-ws-protobuf.js",
    "build:twitch": "cd apps/admin/pages/twitch && zip -r twitch-extension.zip ./*",
    "logs": "pm2 log",
    "prepare": "husky",
    "test:server": "npm run test --workspace @pixelbattle/server",
    "test:app": "node --test apps/app/tests/*.test.mjs && cargo test --locked --workspace"
  },
  "author": "Roman Bauer",
  "license": "ISC",
  "dependencies": {
    "bad-words-next": "^2.3.1",
    "canvas": "3.2.3",
    "chart.js": "^4.4.7",
    "classnames": "^2.3.2",
    "crypto": "^1.0.1",
    "event-emitter": "^0.3.5",
    "is-mobile": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.6.9",
    "parcel": "^2.10.3",
    "protobufjs": "8.8.1",
    "react": "^18.2.0",
    "react-chartkick": "^0.5.4",
    "react-dom": "^18.2.0",
    "res": "^0.4.0",
    "sqlite3": "^5.1.7",
    "src": "^1.1.2",
    "typescript": "^5.0.2",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.10.3",
    "@parcel/transformer-svg-react": "^2.10.3",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18.0.29",
    "@types/react-dom": "^18.0.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "autoprefixer": "^10.4.14",
    "cli-progress": "^3.12.0",
    "concurrently": "^9.2.4",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "form-data": "^4.0.0",
    "husky": "^9.1.7",
    "maxmind": "^4.3.20",
    "nodemon": "^3.1.9",
    "pm2": "^5.3.1",
    "postcss": "^8.4.21",
    "postcss-assets": "^6.0.0",
    "postcss-modules": "^4.3.1",
    "sass": "^1.70.0",
    "ts-node": "^10.9.2",
    "typescript-plugin-css-modules": "^5.0.0",
    "yargs": "^17.7.2"
  },
  "private": true,
  "workspaces": [
    "apps/admin",
    "apps/server"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  }
}
