component ColorInset inherits Rectangle {
    border-width: 2px;
    border-radius: 5px;
    border-color: #2d2d3a;
    Rectangle { x: 2px; y: parent.height - 2px; width: parent.width - 4px; height: 2px; background: #b6b5eb; }
    Rectangle { x: parent.width - 2px; y: 2px; width: 2px; height: parent.height - 4px; background: #b6b5eb; }
}

component ColorButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();
    background: hit.pressed ? #8080a6 : hit.has-hover ? #b5b4ea : #9e9ecc;
    border-radius: 3px;
    border-width: 2px;
    border-color: hit.pressed ? #b6b5eb : #2d2d3a;
    Rectangle { x: 2px; y: 0; width: parent.width - 4px; height: 2px; background: hit.pressed ? #2d2d3a : #b6b5eb; }
    Rectangle { x: 0; y: 2px; width: 2px; height: parent.height - 4px; background: hit.pressed ? #2d2d3a : #b6b5eb; }
    Text {
        text: root.label;
        color: black;
        font-family: "Custom Font ttf 12h 1.0";
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Image { width: 24px; height: 24px; source: root.icon; }
    hit := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.label == "" ? "Пипетка" : root.label;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
    }
}

export component PaletteEditor inherits Rectangle {
    in property <float> hue;
    in property <float> saturation;
    in property <float> value;
    in property <color> hue-color;
    in property <color> sample;
    in property <bool> editing;
    in-out property <string> hex;
    callback adjust(float, float, float);
    callback hex-edited(string);
    callback hex-committed();
    callback save();
    callback remove();
    callback cancel();
    callback pick();

    property <length> gradient-height: Math.max(16px, root.height - 68px);
    property <color> indicator: rgb(255 - root.sample.red, 255 - root.sample.green, 255 - root.sample.blue);

    ColorInset {
        x: 0; y: 4px;
        width: root.width - 26px; height: root.gradient-height;
        Rectangle {
            x: 2px; y: 2px;
            width: parent.width - 4px; height: parent.height - 4px;
            clip: true;
            background: root.hue-color;
            Rectangle { background: @linear-gradient(90deg, white 0%, #fff0 100%); }
            Rectangle { background: @linear-gradient(180deg, #0000 0%, black 100%); }
            Rectangle {
                width: 16px; height: 16px;
                x: root.saturation * parent.width - 8px;
                y: (1 - root.value) * parent.height - 8px;
                Rectangle { x: 7px; y: 0; width: 2px; height: 5px; background: root.indicator; }
                Rectangle { x: 7px; y: 11px; width: 2px; height: 5px; background: root.indicator; }
                Rectangle { x: 0; y: 7px; width: 5px; height: 2px; background: root.indicator; }
                Rectangle { x: 11px; y: 7px; width: 5px; height: 2px; background: root.indicator; }
            }
            TouchArea {
                mouse-cursor: crosshair;
                function select() {
                    root.adjust(root.hue, Math.max(0, Math.min(1, self.mouse-x / self.width)),
                        1 - Math.max(0, Math.min(1, self.mouse-y / self.height)));
                }
                clicked => { self.select(); }
                moved => { if self.pressed { self.select(); } }
            }
        }
    }

    ColorInset {
        x: root.width - 20px; y: 4px;
        width: 20px; height: root.gradient-height;
        Rectangle {
            x: 2px; y: 2px;
            width: parent.width - 4px; height: parent.height - 4px;
            background: @linear-gradient(180deg, red 0%, yellow 16.67%, lime 33.33%, cyan 50%, blue 66.67%, magenta 83.33%, red 100%);
            TouchArea {
                mouse-cursor: pointer;
                function select() {
                    root.adjust(Math.max(0, Math.min(1, self.mouse-y / self.height)), root.saturation, root.value);
                }
                clicked => { self.select(); }
                moved => { if self.pressed { self.select(); } }
            }
        }
        Path {
            x: -6px; y: 2px + root.hue * (parent.height - 4px) - 5px;
            width: 5px; height: 10px;
            fill: black;
            commands: "M 0 0 L 5 5 L 0 10 Z";
        }
    }

    HorizontalLayout {
        x: 0; y: root.gradient-height + 7px; width: Math.min(root.width, 199px); height: 30px;
        spacing: 10px;
        ColorInset { width: 30px; background: root.sample; }
        Text {
            width: 40px; text: "Цвет:"; color: black;
            font-family: "Custom Font ttf 12h 1.0"; font-size: 16px;
            vertical-alignment: center;
        }
        ColorInset {
            min-width: 0px;
            horizontal-stretch: 1;
            background: #bbbaf1;
            input := TextInput {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                text <=> root.hex;
                color: black;
                font-family: "Custom Font ttf 12h 1.0"; font-size: 16px;
                vertical-alignment: center;
                edited => { root.hex-edited(self.text); }
                changed has-focus => {
                    if !self.has-focus { root.hex-committed(); }
                }
                accepted => { root.save(); }
            }
        }
        ColorButton { width: 30px; icon: @image-url("../../assets/eye-dropper.png"); clicked => { root.pick(); } }
    }
    HorizontalLayout {
        x: 0; y: root.gradient-height + 42px; width: Math.min(root.width, root.editing ? 202px : 128px);
        height: 26px;
        spacing: 4px;
        ColorButton { label: "OK"; preferred-width: 62px; clicked => { root.save(); } }
        ColorButton { label: "Отмена"; preferred-width: 62px; clicked => { root.cancel(); } }
        if root.editing: ColorButton { label: "Удалить"; preferred-width: 70px; clicked => { root.remove(); } }
    }
}
